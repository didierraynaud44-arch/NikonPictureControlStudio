{
  "name": "nikon-picture-control-studio",
  "version": "0.2.24",
  "description": "Éditeur Nikon Picture Control",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder"
  },
  "author": "Didier Raynaud",
  "license": "MIT",
  "build": {
    "appId": "com.didierraynaud.nikonpcstudio",
    "productName": "Nikon Picture Control Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "bin/**/*",
      "**/node_modules/nikon-flexible-color-picture-control/**/*",
      "**/node_modules/sharp/**/*",
      "**/node_modules/sqlite3/**/*",
      "**/node_modules/exiftool-vendored/**/*",
      "**/node_modules/libraw-wasm/**/*",
      "db.js",
      "services/catalogService.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "shortcutName": "Nikon PC Studio"
    }
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-store": "^10",
    "exifr": "^7.1.3",
    "exifreader": "^4",
    "exiftool-vendored": "^37.0.0",
    "libraw-wasm": "^1.6.0",
    "nikon-flexible-color-picture-control": "^1",
    "sharp": "^0.34",
    "sqlite3": "^5.1.7"
  }
}
